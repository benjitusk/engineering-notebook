---
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Prose from '../components/Prose.astro';
import EmailLink from '../components/EmailLink.astro';
import { GITHUB_URL } from '../consts';
---

<BaseLayout title='About · Benji Tusk' description='About Benji Tusk and this engineering notebook.' width='prose'>
    <Hero title='About'>
        <Eyebrow slot='eyebrow' tone='accent'>Who's writing this</Eyebrow>
        <Fragment slot='lede'>
            I'm Benji, a computer science graduate who likes taking things apart to see how they work.
        </Fragment>
    </Hero>

    <Prose>
        <p>
            This is my engineering notebook. I write about projects while I'm still working on them: what I tried, what
            broke, and what I figured out along the way. I explain why in <a href='/projects/notebook-init/'
                >my first post</a
            >.
        </p>
        <p>I'll write more here soon.</p>

        <h2>Get in touch</h2>
        <p>
            My code is on <a href={GITHUB_URL} target='_blank' rel='noopener noreferrer'>GitHub</a>, and you can reach
            me at <EmailLink />.
        </p>
    </Prose>
</BaseLayout>
