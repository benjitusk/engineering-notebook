---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { lastUpdated } from '../../lib/post-dates.js';

export async function getStaticPaths() {
    // Drafts are previewable in `astro dev` but never built for production, which also keeps
    // them out of the sitemap (it lists only built pages).
    const posts = await getCollection('projects', (post) => import.meta.env.DEV || !post.data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}
type Props = CollectionEntry<'projects'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} slug={post.id} updatedDate={lastUpdated(post)}>
    <Content />
</BlogPost>
