---
/**
 * ProjectList — a numbered list of investigations. Wraps ProjectListItem
 * children. Items auto-number (01, 02, 03…) unless an item sets `number`.
 *
 * <ProjectList>
 *   <ProjectListItem title="Learning Vim" href="/projects/learning-vim">
 *     Rebuilding my editing workflow around Vim…
 *   </ProjectListItem>
 * </ProjectList>
 */
interface Props {
    /** Let items be reordered by the sort control (see ProjectSort). Items
     *  supply `orderPublished` / `orderUpdated`; the DOM stays in publish
     *  order, so the list reads correctly without JavaScript. */
    sortable?: boolean;
    class?: string;
}

const { sortable, class: className } = Astro.props;
---

<ol class:list={['project-list', className]} data-sortable={sortable ? '' : undefined}>
    <slot />
</ol>

<style>
    .project-list {
        margin: 0;
        border-top: var(--border-width) solid var(--border);
        counter-reset: investigation;
    }

    .project-list[data-sortable] {
        display: flex;
        flex-direction: column;
    }
    .project-list[data-sortable] > :global(li) {
        order: var(--order-published, 0);
    }
    :global(:root[data-project-sort='updated']) .project-list[data-sortable] > :global(li) {
        order: var(--order-updated, 0);
    }
</style>
