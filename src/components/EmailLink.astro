---
import { AUTHOR_EMAIL } from '../consts';

interface Props {
    /** Address to link. Defaults to the site author. */
    email?: string;
    /** Fixed visible text (e.g. "Email"). If omitted, the address itself is shown. */
    label?: string;
    class?: string;
}

const { email = AUTHOR_EMAIL, label, class: className } = Astro.props;

if (!email) {
    throw new Error('AUTHOR_EMAIL is not set. Add it to .env (see .env.example).');
}

// Base64 the address so the raw string never ships in the HTML source.
// Bots scanning for `foo@bar.com` or `mailto:` find nothing to scrape.
const encoded = Buffer.from(email).toString('base64');

// Human-readable, scraper-resistant fallback for the no-JS case.
const [user, domain] = email.split('@');
const fallback = label ?? `${user} .at. ${domain.replace(/\./g, ' .dot. ')}`;
const keepText = label != null ? 'true' : 'false';
---

<a class:list={['email-link', className]} href="#" data-email={encoded} data-keep-text={keepText}>{fallback}</a>

<script>
    // Reconstruct the mailto link client-side, after the HTML has been served.
    for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-email]')) {
        const address = atob(el.dataset.email!);
        el.href = `mailto:${address}`;
        if (el.dataset.keepText !== 'true') el.textContent = address;
        el.removeAttribute('data-email');
        el.removeAttribute('data-keep-text');
    }
</script>
