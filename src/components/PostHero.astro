---
import type { CollectionEntry } from 'astro:content';
import { renderPostArt } from '../lib/art/index.js';

/**
 * PostHero — the figure at the top of a project post: its hand drawing
 * (src/lib/art) on a 2:1 sheet of graph paper, or, for a post without one,
 * the generated figure (src/lib/hero). Tweak a generated figure with `hero`
 * in frontmatter and preview variations with `npm run hero`.
 */
type Data = CollectionEntry<'projects'>['data'];

interface Props {
    slug: string;
    title: string;
    number?: string;
    pubDate?: Date;
    tags?: string[];
    status?: string;
    hero?: Data['hero'];
    class?: string;
}

const { class: className, ...post } = Astro.props;
const { svg } = renderPostArt(post, { shape: 'wide' });
---

<figure class:list={['post-hero-figure', className]} set:html={svg} />

<style>
    .post-hero-figure {
        margin: 0;
        overflow: hidden;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-md);
        background: var(--background);
        line-height: 0;
    }

    .post-hero-figure :global(svg) {
        display: block;
        width: 100%;
        height: auto;
    }
</style>
