---
import { AUTHOR_NAME, GITHUB_URL, RSS_PATH } from '../consts';
import EmailLink from './EmailLink.astro';

const year = new Date().getFullYear();
---

<footer class='site-footer'>
    <div class='site-footer__inner'>
        <p class='site-footer__copy'>&copy; {year} {AUTHOR_NAME}</p>

        <nav class='site-footer__links' aria-label='Footer'>
            <a href={GITHUB_URL} target='_blank' rel='noopener noreferrer'>GitHub</a>
            <a href={RSS_PATH}>RSS</a>
            <EmailLink label='Email' />
        </nav>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: var(--space-32);
        border-top: var(--border-width) solid var(--border);
    }

    .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        max-width: var(--measure-wide);
        margin: 0 auto;
        padding: var(--space-8) var(--gutter);
    }

    .site-footer__copy {
        margin: 0;
        color: var(--text-subtle);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }

    .site-footer__links {
        display: flex;
        gap: var(--space-6);
    }
    /* :global(a) so the rule also reaches the <a> rendered by <EmailLink />,
       which carries that component's scope id rather than the footer's.
       Constrained under the scoped .site-footer__links parent, so it can't leak. */
    .site-footer__links :global(a) {
        color: var(--text-muted);
        font-size: var(--text-sm);
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease);
    }
    .site-footer__links :global(a:hover) {
        color: var(--text);
    }
</style>
