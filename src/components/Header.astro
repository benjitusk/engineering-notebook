---
import Branding from './Branding.astro';
import HeaderLink from './HeaderLink.astro';
import { GITHUB_URL, RSS_PATH } from '../consts';
---

<header class='site-header'>
    <nav class='site-nav' aria-label='Primary'>
        <Branding />

        <div class='site-nav__right'>
            <div class='site-nav__links'>
                <HeaderLink href='/blog'>Projects</HeaderLink>
                <HeaderLink href='/about'>About</HeaderLink>
            </div>

            <div class='site-nav__social'>
                <a href={GITHUB_URL} target='_blank' rel='noopener noreferrer' class='icon-link' aria-label='GitHub'>
                    <svg viewBox='0 0 24 24' aria-hidden='true'>
                        <path
                            fill='currentColor'
                            d='M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577
                            0-.285-.01-1.04-.015-2.04-3.338.725-4.043-1.61-4.043-1.61
                            -.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.73.084-.73
                            1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305
                            3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332
                            -5.466-5.93 0-1.31.465-2.38 1.235-3.22-.125-.303-.535-1.523.117-3.176
                            0 0 1.008-.322 3.3 1.23A11.49 11.49 0 0 1 12 6.844c1.02.005
                            2.045.138 3.005.404 2.29-1.552 3.297-1.23 3.297-1.23.653
                            1.653.243 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22
                            0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.103.823 2.222
                            0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576
                            C20.565 21.796 24 17.297 24 12 24 5.37 18.63 0 12 0z'
                        ></path>
                    </svg>
                </a>

                <a href={RSS_PATH} class='icon-link' aria-label='RSS feed'>
                    <svg viewBox='0 0 24 24' aria-hidden='true'>
                        <path
                            fill='currentColor'
                            d='M5.5 18.5A2.5 2.5 0 1 1 3 21a2.5 2.5 0 0 1 2.5-2.5ZM3 3v3a15 15 0 0 1 15 15h3A18 18 0 0 0 3 3Zm0 6v3a9 9 0 0 1 9 9h3A12 12 0 0 0 3 9Z'
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </nav>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: var(--z-header);
        border-bottom: var(--border-width) solid var(--border);
        background: color-mix(in srgb, var(--background) 85%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-8);
        max-width: var(--measure-wide);
        min-height: 72px;
        margin: 0 auto;
        padding: 0 var(--gutter);
    }

    .site-nav__right {
        display: flex;
        align-items: center;
        gap: var(--space-8);
    }

    .site-nav__links {
        display: flex;
        align-items: center;
        gap: var(--space-6);
    }

    .site-nav__social {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        padding-left: var(--space-6);
        border-left: var(--border-width) solid var(--border);
    }

    .icon-link {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-sm);
        color: var(--text-subtle);
        transition:
            color var(--duration-fast) var(--ease),
            background-color var(--duration-fast) var(--ease);
    }
    .icon-link:hover {
        color: var(--text);
        background: var(--code-background);
    }
    .icon-link svg {
        width: 18px;
        height: 18px;
    }

    @media (max-width: 720px) {
        .site-nav {
            min-height: 64px;
            padding: 0 var(--space-4);
            gap: var(--space-4);
        }
        .site-nav__right {
            gap: var(--space-4);
        }
        .site-nav__social {
            padding-left: var(--space-3);
        }
    }
</style>
