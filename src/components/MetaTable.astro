---
/**
 * MetaTable — the spec block at the top of a project page.
 * Pass an ordered label→value record; rows render in insertion order.
 *
 * <MetaTable data={{ Status: 'Working prototype', Platform: 'Linux',
 *                    Language: 'Rust', Hardware: 'I²C / USB' }} />
 */
interface Props {
    data?: Record<string, string>;
    class?: string;
}

const { data = {}, class: className } = Astro.props;
const rows = Object.entries(data);
---

{
    rows.length > 0 && (
        <dl class:list={['meta', className]}>
            {rows.map(([label, value]) => (
                <div class='meta__row'>
                    <dt class='meta__label'>{label}</dt>
                    <dd class='meta__value'>{value}</dd>
                </div>
            ))}
        </dl>
    )
}

<style>
    .meta {
        margin: 0;
        border-top: var(--border-width) solid var(--border);
    }

    .meta__row {
        display: grid;
        grid-template-columns: minmax(6rem, 9rem) 1fr;
        gap: var(--space-4);
        padding: var(--space-2) 0;
        border-bottom: var(--border-width) solid var(--border);
    }

    .meta__label {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--text-subtle);
        line-height: var(--leading-normal);
        padding-top: 0.15em;
    }

    .meta__value {
        margin: 0;
        color: var(--text);
        font-size: var(--text-base);
    }

    @media (max-width: 480px) {
        .meta__row {
            grid-template-columns: 1fr;
            gap: var(--space-1);
        }
    }
</style>
