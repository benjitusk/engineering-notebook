---
/**
 * ProjectListItem — one row in a ProjectList. Must be a direct child of
 * <ProjectList>. Description goes in the default slot.
 */
interface Props {
    title: string;
    href: string;
    /** Override the auto-generated number (e.g. "07"). */
    number?: string;
    class?: string;
}

const { title, href, number, class: className } = Astro.props;
const auto = number === undefined;
---

<li class:list={['pli', className]}>
    <a href={href} class='pli__link'>
        <span class='pli__num' data-auto={auto}>{number}</span>
        <span class='pli__body'>
            <span class='pli__title'>{title}</span>
            <span class='pli__desc'><slot /></span>
        </span>
        <span class='pli__arrow' aria-hidden='true'>↗</span>
    </a>
</li>

<style>
    .pli {
        counter-increment: investigation;
        border-bottom: var(--border-width) solid var(--border);
    }

    .pli__link {
        display: grid;
        grid-template-columns: 3rem 1fr 1.5rem;
        gap: var(--space-4);
        align-items: start;
        padding: var(--space-6) 0;
        color: inherit;
        text-decoration: none;
    }

    .pli__num {
        color: var(--text-subtle);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        padding-top: 0.2em;
    }
    /* Auto-number: 01, 02, 03… when no explicit number was passed. */
    .pli__num[data-auto='true']::before {
        content: counter(investigation, decimal-leading-zero);
    }

    .pli__title {
        display: block;
        margin-bottom: var(--space-2);
        color: var(--text);
        font-size: var(--text-xl);
        font-weight: var(--weight-bold);
        letter-spacing: var(--tracking-tight);
    }
    .pli__link:hover .pli__title {
        text-decoration: underline;
        text-underline-offset: 5px;
    }

    .pli__desc {
        display: block;
        max-width: 600px;
        color: var(--text-muted);
        line-height: var(--leading-normal);
    }

    .pli__arrow {
        color: var(--text-subtle);
        font-size: var(--text-lg);
        text-align: right;
        transition:
            transform var(--duration) var(--ease),
            color var(--duration-fast) var(--ease);
    }
    .pli__link:hover .pli__arrow {
        color: var(--accent);
        transform: translate(2px, -2px);
    }

    @media (max-width: 600px) {
        .pli__link {
            grid-template-columns: 2rem 1fr 1.25rem;
            gap: var(--space-3);
        }
        .pli__title {
            font-size: var(--text-lg);
        }
    }
</style>
