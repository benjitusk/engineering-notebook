---
/**
 * Tags — a row of monospace chips for technologies / topics.
 * e.g. <Tags tags={['Reverse engineering', 'Linux', 'I²C', 'USB']} />
 */
interface Props {
    tags?: string[];
    class?: string;
}

const { tags = [], class: className } = Astro.props;
---

{
    tags.length > 0 && (
        <ul class:list={['tags', className]}>
            {tags.map((tag) => (
                <li class='tags__item'>{tag}</li>
            ))}
        </ul>
    )
}

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
    }

    .tags__item {
        padding: var(--space-1) var(--space-3);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--leading-normal);
    }
</style>
