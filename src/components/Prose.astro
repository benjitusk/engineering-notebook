---
/**
 * Prose — wraps long-form content (Markdown <slot/>, or hand-written markup)
 * and applies the notebook's reading typography: rhythm, headings, lists,
 * quotes, tables, and code. Authors never style body content directly — they
 * put it inside <Prose> and it comes out right.
 */
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
    <slot />
</div>

<style>
    .prose {
        color: var(--text-muted);
        font-size: var(--text-md);
        line-height: var(--leading-relaxed);
    }

    /* Vertical rhythm: space comes before block elements, collapsed at edges. */
    .prose :global(> * + *) {
        margin-top: var(--space-4);
    }
    .prose :global(> * + h2),
    .prose :global(> * + h3),
    .prose :global(> * + h4) {
        margin-top: var(--space-12);
    }
    .prose :global(> :first-child) {
        margin-top: 0;
    }

    /* Headings */
    .prose :global(h2) {
        font-size: var(--text-2xl);
        letter-spacing: var(--tracking-tight);
        color: var(--text);
    }
    .prose :global(h3) {
        font-size: var(--text-xl);
        color: var(--text);
    }
    .prose :global(h4) {
        font-size: var(--text-lg);
        color: var(--text);
    }
    .prose :global(h2 + *),
    .prose :global(h3 + *),
    .prose :global(h4 + *) {
        margin-top: var(--space-4);
    }

    /* Links inside prose keep the accent underline from base.css. */

    /* Lists — restore markers stripped by the reset, indented into the margin. */
    .prose :global(ul),
    .prose :global(ol) {
        padding-left: var(--space-6);
    }
    .prose :global(ul) {
        list-style: disc;
    }
    .prose :global(ol) {
        list-style: decimal;
    }
    .prose :global(li) {
        margin-top: var(--space-2);
    }
    .prose :global(li::marker) {
        color: var(--text-subtle);
    }

    /* Blockquote — a technical-pen left rule. */
    .prose :global(blockquote) {
        margin: 0;
        padding-left: var(--space-6);
        border-left: 3px solid var(--accent);
        color: var(--text);
        font-style: italic;
    }

    /* Inline code */
    .prose :global(:not(pre) > code) {
        padding: 0.15em 0.4em;
        background: var(--code-background);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.875em;
        color: var(--text);
    }

    /* Code blocks — Shiki emits <pre class="astro-code"> with inline token
       colours; we own the surface so it reads as a capture on paper. */
    .prose :global(pre) {
        padding: var(--space-6);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-md);
        overflow-x: auto;
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
    }
    .prose :global(pre.astro-code) {
        background-color: var(--code-background) !important;
    }
    /* Dark theme: Shiki inlines light token colours and exposes the dark
       ones as --shiki-dark. Same condition as the dark block in tokens.css. */
    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme='light'])) .prose :global(pre.astro-code),
        :global(:root:not([data-theme='light'])) .prose :global(pre.astro-code span) {
            color: var(--shiki-dark) !important;
        }
    }
    .prose :global(pre) :global(code) {
        font-family: var(--font-mono);
    }

    /* Markdown callouts (`> [!type] Title`, generated by satteri-callouts).
       The obsidian theme stylesheet only supplies structure (title layout,
       fold icon). Colour follows the semantic palette; typography separates
       groups that share a colour. Base look matches <Callout>.

         note, info            charcoal, mono label
         abstract/summary/tldr ink bar, no wash, sans headline, body in ink
         todo                  dashed grey bar, no wash — unfinished
         question/help/faq     dashed blue bar, no wash, italic headline
         quote/cite            no box — a rule and italic ink, like blockquote
         example               violet
         tip/hint              blue
         important             blue, body in ink
         success/check/done    green
         warning/attention/
           caution             amber, mono label
         failure/fail/missing  amber, sans headline (as <Callout variant=failed>)
         danger/error          red
         bug                   red, dashed bar
         console               terminal frame (below)

       Scoped to [data-callout] so the <Callout> component is left alone. */
    .prose :global(.callout[data-callout]) {
        /* Per-type locals, as in <Callout>: --bar, --tint, --label, plus
           --bar-style for the left rule. */
        --bar: var(--border-strong);
        --bar-style: solid;
        --tint: var(--surface);
        --label: var(--text-subtle);

        margin-bottom: 0;
        padding: var(--space-6) var(--space-8);
        border: var(--border-width) solid var(--border);
        border-left: 3px var(--bar-style) var(--bar);
        border-radius: var(--radius-sm);
        background-color: var(--tint);
        mix-blend-mode: normal;
        color: var(--text-muted);
        line-height: var(--leading-relaxed);
    }

    /* ---- Colour + rule per group ---- */
    .prose :global(.callout:is([data-callout='abstract'], [data-callout='summary'], [data-callout='tldr'])) {
        --bar: var(--text);
        --tint: transparent;
        --label: var(--text);
        color: var(--text);
    }
    .prose :global(.callout[data-callout='todo']) {
        --bar-style: dashed;
        --tint: transparent;
    }
    .prose :global(.callout:is([data-callout='question'], [data-callout='help'], [data-callout='faq'])) {
        --bar: var(--accent);
        --bar-style: dashed;
        --tint: transparent;
        --label: var(--accent);
    }
    .prose :global(.callout[data-callout='example']) {
        --bar: var(--example);
        --tint: var(--example-subtle);
        --label: var(--example);
    }
    .prose :global(.callout:is([data-callout='tip'], [data-callout='hint'], [data-callout='important'])) {
        --bar: var(--accent);
        --tint: var(--accent-subtle);
        --label: var(--accent);
    }
    .prose :global(.callout[data-callout='important']) {
        color: var(--text);
    }
    .prose :global(.callout:is([data-callout='success'], [data-callout='check'], [data-callout='done'])) {
        --bar: var(--success);
        --tint: var(--success-subtle);
        --label: var(--success);
    }
    .prose
        :global(
            .callout:is(
                    [data-callout='warning'],
                    [data-callout='attention'],
                    [data-callout='caution'],
                    [data-callout='failure'],
                    [data-callout='fail'],
                    [data-callout='missing']
                )
        ) {
        --bar: var(--warning);
        --tint: var(--warning-subtle);
        --label: var(--warning);
    }
    .prose :global(.callout:is([data-callout='danger'], [data-callout='error'], [data-callout='bug'])) {
        --bar: var(--danger);
        --tint: var(--danger-subtle);
        --label: var(--danger);
    }
    .prose :global(.callout[data-callout='bug']) {
        --bar-style: dashed;
    }

    /* Quote / cite: no box, just the rule and italic ink. */
    .prose :global(.callout:is([data-callout='quote'], [data-callout='cite'])) {
        --tint: transparent;
        padding: 0 0 0 var(--space-6);
        border-top: 0;
        border-right: 0;
        border-bottom: 0;
        border-radius: 0;
        color: var(--text);
        font-style: italic;
    }

    /* ---- Title typography ---- */
    .prose :global(.callout[data-callout] > .callout-title) {
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
        color: var(--label);
    }
    .prose :global(.callout[data-callout] > .callout-title .callout-title-text) {
        font-weight: var(--weight-semibold);
    }
    .prose :global(.callout[data-callout] > .callout-title svg) {
        width: var(--text-sm);
        height: var(--text-sm);
    }
    .prose :global(.callout[data-callout] .callout-fold-icon) {
        margin-left: auto;
        padding-inline-end: 0;
    }
    .prose :global(.callout[data-callout] > .callout-content) {
        margin-top: var(--space-3);
    }
    .prose :global(.callout[data-callout] > .callout-content > * + *) {
        margin-top: var(--space-4);
    }

    /* Headline titles: the title *is* the point (a summary, a question, what
       failed), so it's set as a sans sentence rather than a mono label. */
    .prose
        :global(
            .callout:is(
                    [data-callout='abstract'],
                    [data-callout='summary'],
                    [data-callout='tldr'],
                    [data-callout='question'],
                    [data-callout='help'],
                    [data-callout='faq'],
                    [data-callout='failure'],
                    [data-callout='fail'],
                    [data-callout='missing']
                )
                > .callout-title
        ) {
        font-family: var(--font-sans);
        font-size: var(--text-md);
        letter-spacing: var(--tracking-normal);
        text-transform: none;
        line-height: var(--leading-snug);
    }
    .prose :global(.callout:is([data-callout='question'], [data-callout='help'], [data-callout='faq']) > .callout-title) {
        font-style: italic;
    }
    .prose :global(.callout:is([data-callout='quote'], [data-callout='cite']) > .callout-title) {
        font-style: normal;
    }

    /* Console (`> [!console] Title`) — captured terminal output: a code
       surface with a title bar, and the output flush inside the frame. */
    .prose :global(.callout[data-callout='console']) {
        padding: 0;
        border-left-width: var(--border-width);
        border-left-color: var(--border);
        border-radius: var(--radius-md);
        background-color: var(--code-background);
        line-height: var(--leading-normal);
    }
    .prose :global(.callout[data-callout='console'] > .callout-title) {
        padding: var(--space-2) var(--space-4);
    }
    .prose :global(.callout[data-callout='console'] > .callout-content) {
        margin-top: 0;
    }
    /* Divider between the title bar and the output, only when output shows. */
    .prose :global(.callout[data-callout='console']:not([data-collapsible='true']) > .callout-title),
    .prose :global(.callout[data-callout='console'][open] > .callout-title) {
        border-bottom: var(--border-width) solid var(--border);
    }
    /* The output sits flush inside the frame. */
    .prose :global(.callout[data-callout='console'] .callout-content > pre) {
        margin: 0;
        border: 0;
        border-radius: 0;
    }
    .prose :global(.callout[data-callout='console'] .callout-content > :not(pre)) {
        margin: 0;
        padding: var(--space-3) var(--space-4);
    }

    /* Images / figures */
    .prose :global(img) {
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-md);
    }
    .prose :global(figure) {
        margin: 0;
    }
    .prose :global(figcaption) {
        margin-top: var(--space-2);
        color: var(--text-subtle);
        font-size: var(--text-sm);
    }

    /* Horizontal rule */
    .prose :global(hr) {
        margin: var(--space-12) 0;
        border-top: var(--border-width) solid var(--border);
    }

    /* Tables */
    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
    }
    .prose :global(th),
    .prose :global(td) {
        padding: var(--space-2) var(--space-3);
        border: var(--border-width) solid var(--border);
        text-align: left;
    }
    .prose :global(th) {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--text-subtle);
        background: var(--code-background);
    }
</style>
