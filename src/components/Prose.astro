---
/**
 * Prose — wraps long-form content (Markdown <slot/>, or hand-written markup)
 * and applies the notebook's reading typography: rhythm, headings, lists,
 * quotes, tables, and code. Authors never style body content directly — they
 * put it inside <Prose> and it comes out right.
 */
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
    <slot />
</div>

<style>
    .prose {
        color: var(--text-muted);
        font-size: var(--text-md);
        line-height: var(--leading-relaxed);
    }

    /* Vertical rhythm: space comes before block elements, collapsed at edges. */
    .prose :global(> * + *) {
        margin-top: var(--space-4);
    }
    .prose :global(> * + h2),
    .prose :global(> * + h3),
    .prose :global(> * + h4) {
        margin-top: var(--space-12);
    }
    .prose :global(> :first-child) {
        margin-top: 0;
    }

    /* Headings */
    .prose :global(h2) {
        font-size: var(--text-2xl);
        letter-spacing: var(--tracking-tight);
        color: var(--text);
    }
    .prose :global(h3) {
        font-size: var(--text-xl);
        color: var(--text);
    }
    .prose :global(h4) {
        font-size: var(--text-lg);
        color: var(--text);
    }
    .prose :global(h2 + *),
    .prose :global(h3 + *),
    .prose :global(h4 + *) {
        margin-top: var(--space-4);
    }

    /* Links inside prose keep the accent underline from base.css. */

    /* Lists — restore markers stripped by the reset, indented into the margin. */
    .prose :global(ul),
    .prose :global(ol) {
        padding-left: var(--space-6);
    }
    .prose :global(ul) {
        list-style: disc;
    }
    .prose :global(ol) {
        list-style: decimal;
    }
    .prose :global(li) {
        margin-top: var(--space-2);
    }
    .prose :global(li::marker) {
        color: var(--text-subtle);
    }

    /* Blockquote — a technical-pen left rule. */
    .prose :global(blockquote) {
        margin: 0;
        padding-left: var(--space-6);
        border-left: 3px solid var(--accent);
        color: var(--text);
        font-style: italic;
    }

    /* Inline code */
    .prose :global(:not(pre) > code) {
        padding: 0.15em 0.4em;
        background: var(--code-background);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.875em;
        color: var(--text);
    }

    /* Code blocks — Shiki emits <pre class="astro-code"> with inline token
       colours; we own the surface so it reads as a capture on paper. */
    .prose :global(pre) {
        padding: var(--space-6);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-md);
        overflow-x: auto;
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
    }
    .prose :global(pre.astro-code) {
        background-color: var(--code-background) !important;
    }
    .prose :global(pre) :global(code) {
        font-family: var(--font-mono);
    }

    /* Images / figures */
    .prose :global(img) {
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-md);
    }
    .prose :global(figure) {
        margin: 0;
    }
    .prose :global(figcaption) {
        margin-top: var(--space-2);
        color: var(--text-subtle);
        font-size: var(--text-sm);
    }

    /* Horizontal rule */
    .prose :global(hr) {
        margin: var(--space-12) 0;
        border-top: var(--border-width) solid var(--border);
    }

    /* Tables */
    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
    }
    .prose :global(th),
    .prose :global(td) {
        padding: var(--space-2) var(--space-3);
        border: var(--border-width) solid var(--border);
        text-align: left;
    }
    .prose :global(th) {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        color: var(--text-subtle);
        background: var(--code-background);
    }
</style>
