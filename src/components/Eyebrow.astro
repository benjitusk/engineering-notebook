---
/**
 * Eyebrow — a small monospace label that sits above a heading or section.
 * e.g. <Eyebrow>Engineering Notebook · 2026</Eyebrow>
 *      <Eyebrow tone="accent">Currently investigating</Eyebrow>
 */
interface Props {
    /** Element to render as. Defaults to <p>. */
    as?: keyof HTMLElementTagNameMap;
    /** Colour emphasis. 'subtle' (default) reads as quiet metadata. */
    tone?: 'subtle' | 'muted' | 'accent';
    class?: string;
}

const { as: Tag = 'p', tone = 'subtle', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', className]} data-tone={tone}>
    <slot />
</Tag>

<style>
    .eyebrow {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .eyebrow[data-tone='subtle'] {
        color: var(--text-subtle);
    }
    .eyebrow[data-tone='muted'] {
        color: var(--text-muted);
    }
    .eyebrow[data-tone='accent'] {
        color: var(--accent);
    }
</style>
